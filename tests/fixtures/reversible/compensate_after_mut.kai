// exit: 1
fn push(msg: string) -> unit { return; return; }

fn onboard() -> unit reversible {
    var x = "original";
    push("started") compensate {
        if x == "original" {
            push("refunded");
        }
    };
    
    x = "changed";
    
    return;
}

fn main() -> int32 {
    onboard();
    return 1;
}
