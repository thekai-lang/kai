// v0.0.9 — reversible commit with a WIDE ledger: 6 mutations of mixed types
// pushed in program order, then committed. All targets are array elements
// (scalar, string, array-of-structs) so every mutation propagates to the
// caller. Regression: commit must walk the ENTIRE activation ledger releasing
// every retained OLD claim exactly once (no leak, no underflow). Exit 63.
type Node = { id: int32; tag: string; }
fn weave(mut a: int32[], mut words: string[], mut nodes: Node[]) -> unit reversible {
    a[0] = 1;
    words[0] = "w0";
    nodes[0].id = 2;
    a[1] = 3;
    words[1] = "w1";
    nodes[0].tag = "n1";
    return;
}
fn main() -> int32 {
    var a = [0, 0];
    var words = ["x", "y"];
    var nodes = [Node { id: 9, tag: "t" }];
    weave(a, words, nodes);
    var total = 0;
    if a[0] == 1 { total += 1; }
    if words[0] == "w0" { total += 2; }
    if nodes[0].id == 2 { total += 4; }
    if a[1] == 3 { total += 8; }
    if words[1] == "w1" { total += 16; }
    if nodes[0].tag == "n1" { total += 32; }
    return total;
}
